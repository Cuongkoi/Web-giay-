@model Product
@{ViewData["Title"]=Model.Name;var available=(Dictionary<int,int>)ViewBag.AvailableQuantities;}
<div class="container"><div class="breadcrumb"><a href="/">Trang chủ</a> / <a href="@Url.Action("Index",new{categoryId=Model.CategoryId})">@(Model.Category!=null?Model.Category.Name:"Sản phẩm")</a> / @Model.Name</div><section class="product-detail"><div class="product-gallery"><div class="detail-image"><img id="product-main-image" src="@(Model.ImageUrl??"/Images/placeholder.svg")" alt="@Model.Name" data-fallback/></div>@if(Model.Images.Count>0){<div class="gallery-thumbnails">@foreach(var image in Model.Images.OrderBy(i=>i.SortOrder).ThenBy(i=>i.Id)){<button type="button" class="gallery-thumb @(image.IsPrimary?"selected":"")" data-gallery-image="@image.Url" aria-label="Xem ảnh sản phẩm"><img src="@image.Url" alt="@Model.Name" data-fallback/></button>}</div>}</div><div><span class="eyebrow">@Model.Brand</span><h1>@Model.Name</h1><div class="price large">@Model.Price.ToString("N0")₫ @if(Model.OriginalPrice>Model.Price){<del>@Model.OriginalPrice.Value.ToString("N0")₫</del>}</div>@if(!string.IsNullOrWhiteSpace(Model.Color)){<p><b>Màu sắc:</b> @Model.Color</p>}<p class="muted">Một lựa chọn mới cho phong cách mỗi ngày.</p><form method="post" data-stock-product="@Model.Id" data-stock-url="@Url.Action("Availability","Cart",new { area="" })" action="@Url.Action("Add","Cart",new { area="" })">@Html.AntiForgeryToken()<fieldset><legend>Chọn kích cỡ (EU)</legend><div class="sizes">@foreach(var v in Model.Variants.OrderBy(v=>v.Size)){<label class="size @(available[v.Id]==0?"unavailable":"")"><input type="radio" name="variantId" value="@v.Id" data-remaining="@available[v.Id]" disabled="@(available[v.Id]==0)" required/><span>@v.Size</span></label>}</div></fieldset><label for="quantity">Số lượng</label><div class="quantity-picker"><button type="button" data-quantity-step="-1" aria-label="Giảm số lượng" disabled>−</button><input class="quantity" id="quantity" type="number" name="quantity" min="1" max="0" value="1" disabled required/><button type="button" data-quantity-step="1" aria-label="Tăng số lượng" disabled>+</button></div><p class="stock-hint muted" data-stock-hint role="status" aria-live="polite">Chọn size để xem số lượng còn có thể thêm.</p><button class="button full" data-stock-submit disabled>@(available.Values.All(q=>q==0)?"TẠM HẾT HÀNG":"THÊM VÀO GIỎ HÀNG →")</button></form><div class="detail-notes"><p>✓ Thanh toán khi nhận hàng</p><p>✓ Miễn phí giao hàng cho đơn từ 2.000.000đ</p></div><h3>Thông tin sản phẩm</h3><p class="description">@Model.Description</p></div></section></div>

@section Scripts {<script src="@Url.Content("~/Scripts/stock-quantity.js")"></script><script>document.querySelectorAll("[data-gallery-image]").forEach(button=>button.addEventListener("click",()=>{document.getElementById("product-main-image").src=button.dataset.galleryImage;document.querySelectorAll("[data-gallery-image]").forEach(b=>b.classList.toggle("selected",b===button));}));</script>}

