@model Catalog
@{var menuCategories=ViewBag.MenuCategories as List<Category> ?? new List<Category>();}
@{ViewData["Title"]="Giày sneaker & phong cách";bool home=string.IsNullOrEmpty(Model.Q)&&string.IsNullOrEmpty(Model.Brand)&&!Model.Sale&&!Model.CategoryId.HasValue;}
@if(home){ @Html.Partial("_Banners",(List<Banner>)ViewBag.HomeBanners) }
<section class="collection" id="collection"><div class="section-heading"><div><span class="eyebrow">CURATED FOR YOUR EVERYDAY</span><h2>@(Model.Sale?"Ưu đãi đang chờ bạn":Model.CategoryName!=null?Model.CategoryName:Model.Brand!=null?"Giày "+Model.Brand:Model.Q!=null?"Kết quả tìm kiếm":"Đôi giày dành cho bạn")<span class="red">.</span></h2></div><span>@Model.Products.Count sản phẩm</span></div><div class="catalog-toolbar"><div class="tabs"><a class="@(!Model.CategoryId.HasValue?"selected":"")" href="/#collection">Tất cả</a>@foreach(var category in menuCategories){<a class="@(Model.CategoryId==category.Id?"selected":"")" href="@Url.Action("Index",new{categoryId=category.Id})#collection">@category.Name</a>}</div><form method="get"><input type="hidden" name="categoryId" value="@Model.CategoryId"/><input type="hidden" name="q" value="@Model.Q"/><label class="sr-only" for="brandId">Thương hiệu</label><select id="brandId" name="brandId" onchange="this.form.submit()"><option value="">Tất cả thương hiệu</option>@foreach(var brand in (List<Brand>)ViewBag.FilterBrands){<option value="@brand.Id" selected="@(Model.BrandId==brand.Id)">@brand.Name</option>}</select><input type="hidden" name="sale" value="@Model.Sale.ToString()"/><label class="sr-only" for="sort">Sắp xếp</label><select id="sort" name="sort" onchange="this.form.submit()"><option value="">Nổi bật nhất</option><option value="price-asc" selected="@(Model.Sort=="price-asc")">Giá tăng dần</option><option value="price-desc" selected="@(Model.Sort=="price-desc")">Giá giảm dần</option></select><noscript><button>Sắp xếp</button></noscript></form></div>
@if(Model.Products.Count==0){<div class="empty"><h3>Chưa tìm thấy sản phẩm phù hợp</h3><a class="button" href="/">Xem tất cả sản phẩm</a></div>}else{<div class="product-grid">@foreach(var p in Model.Products){@Html.Partial("_Card",p)}</div>}</section>


@section Scripts {<script src="@Url.Content("~/Scripts/banners.js")"></script>}

