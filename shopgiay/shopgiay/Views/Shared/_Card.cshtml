@model Product
<article class="product-card"><a class="product-image" href="@Url.Action("Product","Home",new { area="",id=Model.Id })"><img src="@(Model.ImageUrl??"/Images/placeholder.svg")" alt="@Model.Name" data-fallback loading="lazy"/>@if(Model.OriginalPrice>Model.Price){<span class="discount">−@Math.Round((1-Model.Price/Model.OriginalPrice.Value)*100)%</span>}<span class="view-product">KHÁM PHÁ SẢN PHẨM ↗</span></a><div class="product-info"><small>@Model.Brand.ToUpper()</small><a href="@Url.Action("Product","Home",new { area="",id=Model.Id })">@Model.Name</a><div class="price">@Model.Price.ToString("N0")₫ @if(Model.OriginalPrice>Model.Price){<del>@Model.OriginalPrice.Value.ToString("N0")₫</del>}</div><span class="stock-label">@(Model.Variants.Sum(v=>v.Stock)>0?"Có sẵn nhiều size":"Tạm hết hàng")</span></div></article>
