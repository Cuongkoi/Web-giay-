@model List<Order>
@if(Model.Count==0){<p class="empty">Chưa có đơn hàng.</p>}
@foreach(var order in Model){<article class="order-panel"><div class="section-heading"><h3>#@order.Code <span class="badge">@order.Status</span></h3><b>@order.Total.ToString("N0")₫</b></div><small>@order.CreatedAt.AddHours(7).ToString("dd/MM/yyyy HH:mm")</small><p>@(order.PaymentMethod=="TRANSFER"?"Chuyển khoản ngân hàng":order.PaymentMethod) · @(order.PaymentStatus=="Paid"?"Đã thanh toán":order.PaymentStatus=="Review"?"Cần đối soát với VNPay":order.PaymentStatus=="Failed"?"Thanh toán không thành công":"Chưa thanh toán") · <a href="@Url.Action("Complete","Cart",new{area="",code=order.Code})">Xem chi tiết đơn</a></p><p>@order.CustomerName · @order.Phone<br/>@order.Address</p>@foreach(var item in order.Items){<p>@item.ProductName · EU @item.Size × @item.Quantity</p>}@if(order.Discount>0){<p class="red">Voucher @order.VoucherCode: −@order.Discount.ToString("N0")₫</p>}</article>}
