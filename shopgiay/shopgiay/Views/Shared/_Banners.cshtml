@model List<Banner>
@if (Model.Count > 0)
{<section class="managed-banners" aria-label="Banner cửa hàng" data-banners>@for (int i = 0; i < Model.Count; i++)
    {
        var banner = Model[i];<article class="managed-banner @(i==0?"active":"")" data-banner>@if (!string.IsNullOrEmpty(banner.ImageUrl))
        {<img src="@banner.ImageUrl" alt="@banner.Title" />}<div class="managed-banner-copy"><h1>@banner.Title</h1>@if (!string.IsNullOrEmpty(banner.Subtitle))
        {<p>@banner.Subtitle</p>}@if (!string.IsNullOrWhiteSpace(banner.LinkUrl) && !string.IsNullOrWhiteSpace(banner.ButtonText)) { }</div></article>}@if (Model.Count > 1)
{<div class="banner-controls"><button type="button" data-banner-prev aria-label="Banner trước">←</button><span data-banner-position>1 / @Model.Count</span><button type="button" data-banner-next aria-label="Banner sau">→</button></div>}</section>}

