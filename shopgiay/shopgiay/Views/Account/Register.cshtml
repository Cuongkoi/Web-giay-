@model RegisterInput
@{ViewBag.Title="Đăng ký tài khoản";}
<div class="customer-auth container page"><h1>Tạo tài khoản.</h1><p>Lưu đơn hàng, theo dõi mua sắm và nhận ưu đãi dành cho khách quen.</p><form method="post" class="form-panel" action="@Url.Action("Register")">@Html.AntiForgeryToken()@Html.ValidationSummary(false,"",new{@class="validation"})<label for="Name">Họ tên *</label>@Html.TextBoxFor(m=>m.Name,new{autocomplete="name",required="required",maxlength=100})<label for="Email">Email *</label>@Html.TextBoxFor(m=>m.Email,new{type="email",autocomplete="email",required="required",maxlength=180})<label for="Password">Mật khẩu (ít nhất 8 ký tự) *</label>@Html.PasswordFor(m=>m.Password,new{autocomplete="new-password",required="required",minlength=8})<label for="ConfirmPassword">Nhập lại mật khẩu *</label>@Html.PasswordFor(m=>m.ConfirmPassword,new{autocomplete="new-password",required="required"})<div class="checks"><label>@Html.CheckBoxFor(m=>m.ReceiveVoucherEmails) Tôi muốn nhận email thông báo voucher khi trở thành khách quen.</label></div><button class="button full">ĐĂNG KÝ →</button><a href="@Url.Action("Login")">Đã có tài khoản? Đăng nhập</a></form></div>

