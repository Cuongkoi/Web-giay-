@model Order
@{var bank=shopgiay.Services.BankTransferSettingsService.Current;}
<section class="transfer-instructions"><h2>Thanh toán chuyển khoản</h2><p>Quý khách chuyển khoản vui lòng ghi nội dung là tên khách hàng và mã đơn hàng.</p><p>Nội dung chuyển khoản: <strong>@Model.CustomerName @Model.Code</strong></p><p>Số tiền cần chuyển: <strong>@Model.Total.ToString("N0")₫</strong></p>@if(bank.Ready){<img class="payment-qr" src="@bank.QrImageUrl" alt="QR thanh toán chuyển khoản"/>}else{<p>Cửa hàng đang cập nhật QR. Vui lòng liên hệ cửa hàng trước khi chuyển khoản.</p>}@if(!string.IsNullOrEmpty(bank.BankName)){<p>Ngân hàng: @bank.BankName</p>}@if(!string.IsNullOrEmpty(bank.AccountNumber)){<p>Số tài khoản: <b>@bank.AccountNumber</b></p>}@if(!string.IsNullOrEmpty(bank.AccountHolder)){<p>Chủ tài khoản: @bank.AccountHolder</p>}<p>Đơn hàng đang chờ cửa hàng kiểm tra và xác nhận tiền chuyển khoản.</p></section>