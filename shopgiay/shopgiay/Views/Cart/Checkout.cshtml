@model CheckoutInput
@{ViewData["Title"]="Đặt hàng";var discount=(decimal)(ViewBag.Discount??0m);var rows=(List<CartRow>)ViewBag.Rows;var subtotal=rows.Sum(r=>r.Quantity*r.Variant.Product.Price);}
<div class="container page"><span class="eyebrow">ONE STEP CLOSER</span><h1>Thông tin giao hàng.</h1><form method="post" class="checkout-grid" action="@Url.Action("Checkout","Cart",new { area="" })">@Html.AntiForgeryToken()<div class="form-panel">@Html.ValidationSummary(false,"",new { @class="validation" })<label>Họ và tên *</label>@Html.TextBoxFor(m=>m.CustomerName,new { type="text",autocomplete="name" })<label>Số điện thoại *</label>@Html.TextBoxFor(m=>m.Phone,new { type="text",autocomplete="tel" })<label>Địa chỉ nhận hàng *</label>@Html.TextAreaFor(m=>m.Address,new { rows=5 })<label>Ghi chú</label>@Html.TextAreaFor(m=>m.Note,new { rows=5 })</div><aside class="summary"><h2>Đơn hàng của bạn</h2><label for="VoucherCode">Voucher dành cho khách quen</label>@Html.TextBoxFor(m=>m.VoucherCode,new{maxlength=30,placeholder="Nhập mã giảm giá"})<button class="secondary" type="submit" name="applyVoucher" value="true">Áp dụng mã</button><small>Khách có ít nhất 3 đơn hoàn thành được sử dụng. Mỗi mã dùng một lần.</small>@foreach(var r in rows){<p>@r.Variant.Product.Name<br/><small>EU @r.Variant.Size × @r.Quantity · @((r.Quantity*r.Variant.Product.Price).ToString("N0"))₫</small></p>}<div><span>Phí vận chuyển</span><b>@(subtotal>=2000000?"Miễn phí":"35.000₫")</b></div>@if(discount>0){<div class="discount-line"><span>Giảm giá @ViewBag.AppliedCode</span><b>−@discount.ToString("N0")₫</b></div>}<div class="total"><span>Tổng thanh toán</span><b>@((subtotal-discount+(subtotal>=2000000?0:35000)).ToString("N0"))₫</b></div><fieldset class="payment-methods"><legend>Phương thức thanh toán</legend><label>@Html.RadioButtonFor(m=>m.PaymentMethod,"COD") Thanh toán khi nhận hàng (COD)</label><label>@Html.RadioButtonFor(m=>m.PaymentMethod,"TRANSFER") Chuyển khoản ngân hàng</label><div id="transfer-preview" hidden>@{var bank=shopgiay.Services.BankTransferSettingsService.Current;}<p>Quý khách chuyển khoản vui lòng ghi nội dung là tên khách hàng và mã đơn hàng.</p><small>Đặt hàng trước để nhận mã đơn và nội dung chuyển khoản chính xác.</small>@if(bank.Ready){<img class="payment-qr" src="@bank.QrImageUrl" alt="QR chuyển khoản ngân hàng"/>}else{<small>Cửa hàng chưa thiết lập QR chuyển khoản. Vui lòng chọn COD.</small>}</div></fieldset><button class="button full">XÁC NHẬN ĐẶT HÀNG →</button><small>Kiểm tra số điện thoại và địa chỉ trước khi đặt.</small></aside></form></div>


@section Scripts{<script>function showTransfer(){var selected=document.querySelector('input[name="PaymentMethod"]:checked');document.getElementById('transfer-preview').hidden=!selected||selected.value!=='TRANSFER';}document.querySelectorAll('input[name="PaymentMethod"]').forEach(function(input){input.addEventListener('change',showTransfer);});showTransfer();</script>}
