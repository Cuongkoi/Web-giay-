@model List<CartRow>
@{ViewData["Title"]="Giỏ hàng";var subtotal=Model.Sum(r=>r.Quantity*r.Variant.Product.Price);}
<div class="container page"><span class="eyebrow">YOUR NEXT STEP</span><h1>Giỏ hàng của bạn<span class="red">.</span></h1>@if(Model.Count==0){<div class="empty"><h2>Giỏ hàng đang trống</h2><p>Chọn một đôi giày và bắt đầu hành trình mới.</p><a class="button" href="/">TIẾP TỤC MUA SẮM ↗</a></div>}else{<div class="checkout-grid"><div>@foreach(var r in Model){<article class="cart-row"><img src="@(r.Variant.Product.ImageUrl??"/Images/placeholder.svg")" alt="@r.Variant.Product.Name" data-fallback/><div><a href="/Home/Product/@r.Variant.ProductId"><b>@r.Variant.Product.Name</b></a><p>Size EU @r.Variant.Size · @r.Variant.Product.Price.ToString("N0")₫</p><form method="post" class="inline" action="@Url.Action("Update","Cart",new { area="" })">@Html.AntiForgeryToken()<input type="hidden" name="variantId" value="@r.Variant.Id"/><input aria-label="Số lượng" class="quantity" type="number" name="quantity" min="0" max="20" value="@r.Quantity"/><button class="secondary">Cập nhật</button><button class="text-button red" name="quantity" value="0" type="submit" onclick="this.form.querySelector('input[name=quantity]').value=0">Xóa</button></form></div><strong>@((r.Quantity*r.Variant.Product.Price).ToString("N0"))₫</strong></article>}</div><aside class="summary"><h2>Tóm tắt đơn hàng</h2><div><span>Tạm tính</span><b>@subtotal.ToString("N0")₫</b></div><div><span>Giao hàng</span><b>@(subtotal>=2000000?"Miễn phí":"35.000₫")</b></div><div class="total"><span>Tổng cộng</span><b>@((subtotal+(subtotal>=2000000?0:35000)).ToString("N0"))₫</b></div><a class="button full" href="@Url.Action("Checkout","Cart",new { area="" })">ĐẶT HÀNG →</a><p>Thanh toán khi nhận hàng (COD)</p></aside></div>}</div>
