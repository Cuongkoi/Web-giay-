@model List<Category>
@{ ViewBag.Title="Quản lý danh mục"; }
<div class="container page"><div class="section-heading"><div><span class="eyebrow">CATEGORY MANAGEMENT</span><h1>Danh mục sản phẩm.</h1></div><a class="button" href="@Url.Action("Edit")">+ THÊM DANH MỤC</a></div><p class="muted">Danh mục hiển thị trên menu cửa hàng theo thứ tự bạn chọn. Khi thêm hoặc sửa sản phẩm, chọn danh mục tương ứng.</p>
@if(Model.Count==0){<div class="empty"><h2>Chưa có danh mục</h2><p>Tạo danh mục đầu tiên cho cửa hàng của bạn.</p><a class="button" href="@Url.Action("Edit")">THÊM DANH MỤC</a></div>}else{<div class="table-scroll"><table><thead><tr><th>Tên danh mục</th><th>Thứ tự</th><th>Hiển thị trên menu</th><th>Thao tác</th></tr></thead><tbody>@foreach(var c in Model){<tr><td><b>@c.Name</b></td><td>@c.SortOrder</td><td>@(c.Active?"Có":"Đã ẩn")</td><td><div class="inline"><a class="secondary" href="@Url.Action("Edit",new{id=c.Id})">Sửa</a><form method="post" action="@Url.Action("Delete")" data-confirm="Xóa danh mục này?"><input name="id" type="hidden" value="@c.Id"/>@Html.AntiForgeryToken()<button class="text-button red">Xóa</button></form></div></td></tr>}</tbody></table></div>}</div>
