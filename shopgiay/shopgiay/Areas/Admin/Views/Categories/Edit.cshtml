@model Category
@{ViewBag.Title=Model.Id==0?"Thêm danh mục":"Sửa danh mục";}
<div class="container page"><a href="@Url.Action("Index")">← Danh mục</a><h1>@ViewBag.Title.</h1><form class="form-panel" method="post" action="@Url.Action("Edit",new{id=Model.Id})">@Html.AntiForgeryToken()@Html.ValidationSummary(false,"",new{@class="validation"})<label for="Name">Tên danh mục *</label>@Html.TextBoxFor(m=>m.Name,new{maxlength=180,required="required"})<label for="SortOrder">Thứ tự hiển thị (số nhỏ đứng trước)</label>@Html.TextBoxFor(m=>m.SortOrder,new{type="number",min=0,max=10000})<div class="checks"><label>@Html.CheckBoxFor(m=>m.Active) Hiển thị trên menu cửa hàng</label></div><button class="button">LƯU DANH MỤC →</button></form></div>
