@model BankTransferSettingsInput
@{ViewBag.Title="Cấu hình thanh toán";}
<div class="container page"><h1>Cấu hình thanh toán</h1><p>Khách hàng có thể chọn COD hoặc chuyển khoản ngân hàng.</p><form method="post" enctype="multipart/form-data" class="form-panel">@Html.AntiForgeryToken()@Html.ValidationSummary(false,"",new{@class="validation"})<label>@Html.CheckBoxFor(m=>m.Enabled) Bật thanh toán chuyển khoản</label><label for="BankName">Ngân hàng (tùy chọn)</label>@Html.TextBoxFor(m=>m.BankName,new{maxlength=100})<label for="AccountNumber">Số tài khoản (tùy chọn)</label>@Html.TextBoxFor(m=>m.AccountNumber,new{maxlength=50})<label for="AccountHolder">Tên chủ tài khoản (tùy chọn)</label>@Html.TextBoxFor(m=>m.AccountHolder,new{maxlength=100})<label for="qrFile">Ảnh QR thanh toán</label><input type="file" id="qrFile" name="qrFile" accept="image/png,image/jpeg,.png,.jpg,.jpeg"/><small>Chọn một ảnh PNG/JPG/JPEG, tối đa 5 MB. Ảnh mới thay thế ảnh đã lưu.</small>@if(!string.IsNullOrEmpty(Model.QrImageUrl)){<p><img src="@Model.QrImageUrl" alt="QR chuyển khoản hiện tại" style="max-width:300px;max-height:380px;object-fit:contain"/></p><label><input type="checkbox" name="removeQr" value="true"/> Xóa ảnh QR hiện tại</label>}<p>Hướng dẫn hiển thị cho khách: <b>Quý khách chuyển khoản vui lòng ghi nội dung là tên khách hàng và mã đơn hàng.</b></p><p>Mã đơn và nội dung chuyển khoản đầy đủ sẽ xuất hiện sau khi khách đặt đơn. Admin kiểm tra tiền vào tài khoản rồi xác nhận đã nhận tiền trong mục Đơn hàng.</p><button class="button">LƯU CẤU HÌNH</button></form></div>