@model Product
@{ViewData["Title"]=Model.Id==0?"Thêm sản phẩm":"Sửa sản phẩm";}
<div class="container page"><div class="breadcrumb"><a href="/Admin">Quản trị</a> / Sản phẩm</div><h1>@ViewData["Title"].</h1><form method="post" enctype="multipart/form-data" class="edit-grid" action="@Url.Action("Edit","Products",new { area="Admin",id=Model.Id })">@Html.AntiForgeryToken()<section class="form-panel">@Html.ValidationSummary(false,"",new { @class="validation" })<label for="CategoryId">Danh mục</label>@Html.DropDownListFor(m=>m.CategoryId,(SelectList)ViewBag.ProductCategories,"— Chưa phân loại —")<small>Thêm danh mục tại <a href="/Admin/Categories">Quản lý danh mục</a>.</small><label>Tên sản phẩm *</label>@Html.TextBoxFor(m=>m.Name,new { type="text",maxlength="180" })<div class="two-cols"><div><label for="BrandId">Thương hiệu *</label>@Html.DropDownListFor(m=>m.BrandId,(SelectList)ViewBag.ProductBrands,"— Chọn thương hiệu —",new{required="required"})<small><a href="/Admin/Brands/Edit">+ Thêm thương hiệu</a></small></div><div><label for="Color">Màu sắc *</label>@Html.DropDownListFor(m=>m.Color,new SelectList(ProductColors.All),"— Chọn màu sắc —",new{required="required"})@Html.ValidationMessageFor(m=>m.Color,"",new{@class="validation"})</div><div><label>Giá bán (VNĐ) *</label>@Html.TextBoxFor(m=>m.Price,new { type="number",min="1000",step="1000" })</div><div><label>Giá gốc (để trống nếu không giảm)</label>@Html.TextBoxFor(m=>m.OriginalPrice,new { type="number",min="0",step="1000" })</div></div><label>Mô tả sản phẩm</label>@Html.TextAreaFor(m=>m.Description,new { rows=5 })@Html.Partial("_ImagesEditor",Model)<div class="checks"><label>@Html.CheckBoxFor(m=>m.Featured) Sản phẩm nổi bật</label><label>@Html.CheckBoxFor(m=>m.Active) Hiển thị trên cửa hàng</label></div><div class="inline"><button class="button">LƯU SẢN PHẨM →</button><a class="secondary" href="/Admin">Hủy</a></div></section><aside class="form-panel"><h2>Tồn kho theo size</h2><p class="muted">Nhập 0 nếu size đã hết hàng.</p>@for(int i=0;i<Model.Variants.Count;i++){<div class="inventory-row"><label>EU @Model.Variants[i].Size</label>@Html.HiddenFor(m=>m.Variants[i].Size)@Html.TextBoxFor(m=>m.Variants[i].Stock,new { type="number",min="0",max="10000" })</div>}</aside></form></div>


@section Scripts {<script src="@Url.Content("~/Scripts/product-images.js?v=append-x-1")"></script>}


