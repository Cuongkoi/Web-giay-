@model List<Product>
@{ViewData["Title"]="Quản lý sản phẩm";}
<div class="container page"><div class="section-heading"><div><span class="eyebrow">STORE OVERVIEW</span><h1>Quản lý sản phẩm.</h1></div><a class="button" href="@Url.Action("Edit","Products",new { area="Admin" })">+ THÊM SẢN PHẨM</a></div><div class="stats"><div><small>SẢN PHẨM ĐANG HIỂN THỊ</small><b>@Model.Count(p=>p.Active)</b></div><div><small>TỔNG ĐƠN HÀNG</small><b>@ViewBag.OrderCount</b></div><div><small>DOANH THU HOÀN THÀNH</small><b>@(((decimal)ViewBag.Revenue).ToString("N0"))₫</b></div></div><form method="get" class="admin-search"><input name="q" value="@ViewBag.Q" placeholder="Tìm tên sản phẩm..."/><button class="button">Tìm kiếm</button></form><div class="table-scroll"><table><thead><tr><th>Sản phẩm</th><th>Thương hiệu</th><th>Giá bán</th><th>Tồn kho</th><th>Hiển thị</th><th>Thao tác</th></tr></thead><tbody>@foreach(var p in Model){<tr><td><div class="table-product"><img src="@(p.ImageUrl??"/Images/placeholder.svg")" alt="" data-fallback/><div><b>@p.Name</b><small>@p.Color</small></div></div></td><td>@p.Brand</td><td>@p.Price.ToString("N0")₫</td><td>@p.Variants.Sum(v=>v.Stock)</td><td><span class="badge">@(p.Active?"Đang bán":"Đã ẩn")</span></td><td><div class="inline"><a class="secondary" href="@Url.Action("Edit","Products",new { area="Admin",id=p.Id })">Sửa</a><form method="post" data-confirm="Xóa sản phẩm này? Thao tác không thể hoàn tác." action="@Url.Action("Delete","Products",new { area="Admin" })">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@p.Id"/><button class="text-button red">Xóa</button></form></div></td></tr>}</tbody></table></div>@if(Model.Count==0){<p class="empty">Không có sản phẩm phù hợp.</p>}</div>

