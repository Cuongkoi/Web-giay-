@model List<Order>
@{ViewData["Title"]="Quản lý đơn hàng";}<div class="container page"><span class="eyebrow">ORDER MANAGEMENT</span><h1>Đơn hàng.</h1>@if(Model.Count==0){<div class="empty">Chưa có đơn hàng.</div>}@foreach(var o in Model){<article class="order-panel"><div class="section-heading"><div><h3>#@o.Code <span class="badge">@o.Status</span></h3><small>@o.CreatedAt.AddHours(7).ToString("dd/MM/yyyy HH:mm")</small></div><b>@o.Total.ToString("N0")₫ · @(o.PaymentMethod=="TRANSFER"?"Chuyển khoản ngân hàng":o.PaymentMethod)</b></div><p>Thanh toán: <b>@(o.PaymentStatus=="Paid"?"Đã thanh toán":o.PaymentStatus=="Review"?"Cần đối soát với VNPay":o.PaymentStatus=="Failed"?"Không thành công":"Chưa thanh toán")</b> @if(o.PaymentTransactionNo!=null){<span> · Mã giao dịch: @o.PaymentTransactionNo</span>}</p>@if(o.Status=="Đã hủy"&&o.PaymentStatus=="Paid"){<p class="validation">Đơn đã hủy nhưng nhận được thanh toán. Cần kiểm tra và hoàn tiền với VNPay trước khi xử lý tiếp.</p>}@if(o.PaymentMethod=="TRANSFER"&&o.PaymentStatus!="Paid"&&o.Status!="Đã hủy"){<form method="post" class="inline" action="@Url.Action("ConfirmTransfer","Products",new{area="Admin"})" data-confirm="Bạn đã kiểm tra tài khoản ngân hàng và nhận đủ tiền của đơn này?"><input type="hidden" name="id" value="@o.Id"/>@Html.AntiForgeryToken()<p>Nội dung chuyển khoản: <b>@o.CustomerName @o.Code</b></p><button class="button">Xác nhận đã nhận tiền</button></form>}<p>Email báo chủ shop: @(o.OwnerEmailStatus=="Sent"?"Đã gửi":o.OwnerEmailStatus=="Failed"?"Gửi lỗi, sẽ thử lại":o.OwnerEmailStatus=="Skipped"?"Đơn cũ, không gửi thông báo":"Đang chờ gửi") @o.OwnerEmailRecipient</p><div class="two-cols"><div><b>@o.CustomerName · @o.Phone</b>@if(o.Customer!=null){<p>@o.Customer.Email</p>}<p>@o.Address</p>@if(!string.IsNullOrEmpty(o.Note)){<p>Ghi chú: @o.Note</p>}</div><div>@foreach(var item in o.Items){<p>@item.ProductName · EU @item.Size × @item.Quantity<br/><small>@item.Price.ToString("N0")₫ / đôi</small></p>}</div></div>@if(o.Status!="Hoàn thành"&&o.Status!="Đã hủy"){<form method="post" class="inline" data-confirm="Xác nhận cập nhật trạng thái đơn hàng?" action="@Url.Action("Status","Products",new { area="Admin" })">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@o.Id"/><select name="status" aria-label="Trạng thái đơn hàng">@if(o.Status=="Chờ xác nhận"){<option>Đã xác nhận</option><option>Đã hủy</option>}else if(o.Status=="Đã xác nhận"){<option>Đang giao</option><option>Đã hủy</option>}else{<option>Hoàn thành</option>}</select><button class="button">Cập nhật trạng thái</button></form>}@if(o.Discount>0){<p>Voucher @o.VoucherCode: giảm @o.Discount.ToString("N0")₫</p>}</article>}</div>

