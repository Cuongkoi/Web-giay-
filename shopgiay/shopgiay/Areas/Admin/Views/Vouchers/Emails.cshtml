@model List<VoucherEmail>
@{ViewBag.Title="Thông báo voucher qua email";var customers=(Dictionary<int,string>)ViewBag.Customers;var vouchers=(Dictionary<int,string>)ViewBag.Vouchers;}
<div class="container page"><a href="@Url.Action("Index")">← Voucher</a><h1>Hàng đợi email.</h1>@if(!(bool)ViewBag.SmtpConfigured){<div class="notice error">Chưa có cấu hình Gmail đầy đủ. Thư được giữ ở trạng thái chờ, chưa gửi. Vào <a href="/Admin/EmailSettings">Cấu hình email</a> để nhập Gmail, App Password và bật gửi tự động.</div>}<form method="post" action="@Url.Action("RetryEmails")">@Html.AntiForgeryToken()<button class="button">XỬ LÝ / THỬ GỬI LẠI</button></form><p class="muted">Thư được xếp hàng khi có voucher còn hiệu lực và khách đạt 3 đơn hoàn thành. Chỉ gửi cho khách đã đồng ý nhận email. Đang hiển thị 200 thư gần nhất.</p><div class="table-scroll"><table><thead><tr><th>Người nhận</th><th>Voucher</th><th>Trạng thái</th><th>Đã gửi lúc</th><th>Ghi chú</th></tr></thead><tbody>@foreach(var e in Model){<tr><td>@(customers.ContainsKey(e.CustomerId)?customers[e.CustomerId]:"—")</td><td>@(vouchers.ContainsKey(e.VoucherId)?vouchers[e.VoucherId]:"—")</td><td>@e.Status</td><td>@(e.SentAt.HasValue?e.SentAt.Value.AddHours(7).ToString("dd/MM/yyyy HH:mm"):"Chưa gửi")</td><td>@e.LastError</td></tr>}</tbody></table></div></div>


