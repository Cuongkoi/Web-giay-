@model List<Voucher>
@{ViewBag.Title="Quản lý voucher";}
<div class="container page"><div class="section-heading"><h1>Voucher khách quen.</h1><div class="inline"><a class="secondary" href="@Url.Action("Emails")">Hàng đợi email</a><a class="button" href="@Url.Action("Edit")">+ TẠO VOUCHER</a></div></div><p class="muted">Chỉ tài khoản có ít nhất 3 đơn hoàn thành được áp dụng. Mỗi khách dùng một lần; giảm trên tiền sản phẩm, không giảm phí vận chuyển.</p><div class="table-scroll"><table><thead><tr><th>Mã</th><th>Giảm</th><th>Đơn tối thiểu</th><th>Hiệu lực (giờ VN)</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>@foreach(var v in Model){<tr><td><b>@v.Code</b></td><td>@v.Percent%</td><td>@v.MinimumSubtotal.ToString("N0")₫</td><td>@v.ValidFrom.AddHours(7).ToString("dd/MM/yyyy HH:mm") → @v.ValidUntil.AddHours(7).ToString("dd/MM/yyyy HH:mm")</td><td>@(v.Active?"Đang bật":"Đã ngừng")</td><td><div class="inline"><a class="secondary" href="@Url.Action("Edit",new{id=v.Id})">Sửa</a><form method="post" action="@Url.Action("Delete")">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@v.Id"/><button class="text-button red">Ngừng</button></form></div></td></tr>}</tbody></table></div></div>

