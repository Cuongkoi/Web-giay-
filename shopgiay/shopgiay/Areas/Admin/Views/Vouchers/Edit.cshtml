@model VoucherEditInput
@{ViewBag.Title=Model.Id==0?"Tạo voucher":"Sửa voucher";}
<div class="container page"><a href="@Url.Action("Index")">← Voucher</a><h1>@ViewBag.Title.</h1><form class="form-panel" method="post" action="@Url.Action("Edit",new{id=Model.Id})">@Html.AntiForgeryToken()@Html.ValidationSummary(false,"",new{@class="validation"})<label for="Code">Mã code giảm giá *</label>@Html.TextBoxFor(m=>m.Code,new{maxlength=30,required="required",placeholder="KHACHQUEN10"})<div class="two-cols"><div><label for="Percent">Giảm (%) *</label>@Html.TextBoxFor(m=>m.Percent,new{type="number",min=1,max=100,required="required"})</div><div><label for="MinimumSubtotal">Giá trị đơn tối thiểu (VNĐ)</label>@Html.TextBoxFor(m=>m.MinimumSubtotal,new{type="number",min=0,step=1000})</div><div><label for="StartsLocal">Bắt đầu (giờ Việt Nam)</label>@Html.TextBoxFor(m=>m.StartsLocal,"{0:yyyy-MM-ddTHH:mm}",new{type="datetime-local",required="required"})</div><div><label for="EndsLocal">Kết thúc (giờ Việt Nam)</label>@Html.TextBoxFor(m=>m.EndsLocal,"{0:yyyy-MM-ddTHH:mm}",new{type="datetime-local",required="required"})</div></div><div class="checks"><label>@Html.CheckBoxFor(m=>m.Active) Bật voucher và thông báo cho khách quen đăng ký nhận email</label></div><button class="button">LƯU VOUCHER →</button></form></div>

