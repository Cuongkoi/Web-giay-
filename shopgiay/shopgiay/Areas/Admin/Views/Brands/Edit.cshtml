@model Brand
@{ViewBag.Title=Model.Id==0?"Thêm thương hiệu":"Sửa thương hiệu";}
<div class="container page"><a href="@Url.Action("Index")">← Thương hiệu</a><h1>@ViewBag.Title.</h1><form class="form-panel" method="post" action="@Url.Action("Edit",new{id=Model.Id})">@Html.AntiForgeryToken()@Html.ValidationSummary(false,"",new{@class="validation"})<label for="Name">Tên thương hiệu *</label>@Html.TextBoxFor(m=>m.Name,new{maxlength=50,required="required"})<label for="SortOrder">Thứ tự hiển thị</label>@Html.TextBoxFor(m=>m.SortOrder,new{type="number",min=0,max=10000})<div class="checks"><label>@Html.CheckBoxFor(m=>m.Active) Hiển thị trong bộ lọc thương hiệu</label></div><button class="button">LƯU THƯƠNG HIỆU →</button></form></div>
