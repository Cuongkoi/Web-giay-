@model List<Brand>
@{ ViewBag.Title="Quản lý thương hiệu"; }
<div class="container page"><div class="section-heading"><div><span class="eyebrow">BRAND MANAGEMENT</span><h1>Thương hiệu.</h1></div><a class="button" href="@Url.Action("Edit")">+ THÊM THƯƠNG HIỆU</a></div><p class="muted">Thêm thương hiệu trước khi nhập sản phẩm. Bật/tắt hiển thị điều khiển danh sách lọc ở cửa hàng; sản phẩm được giữ nguyên.</p>
@if(Model.Count==0){<div class="empty"><h2>Chưa có thương hiệu</h2><a class="button" href="@Url.Action("Edit")">THÊM THƯƠNG HIỆU</a></div>}else{<div class="table-scroll"><table><thead><tr><th>Tên thương hiệu</th><th>Thứ tự</th><th>Hiển thị</th><th>Thao tác</th></tr></thead><tbody>@foreach(var b in Model){<tr><td><b>@b.Name</b></td><td>@b.SortOrder</td><td>@(b.Active?"Có":"Đã ẩn")</td><td><div class="inline"><a class="secondary" href="@Url.Action("Edit",new{id=b.Id})">Sửa</a><form method="post" action="@Url.Action("Delete")" data-confirm="Xóa thương hiệu này?"><input name="id" type="hidden" value="@b.Id"/>@Html.AntiForgeryToken()<button class="text-button red">Xóa</button></form></div></td></tr>}</tbody></table></div>}</div>
