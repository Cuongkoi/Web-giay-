@model List<Banner>
@{ViewBag.Title="Quản lý banner";}
<div class="container page"><div class="section-heading"><h1>Banner trang chủ.</h1><a class="button" href="@Url.Action("Edit")">+ THÊM BANNER</a></div><p class="muted">Banner lấy từ dữ liệu admin tạo. Không có banner đang bật thì trang chủ không hiển thị khu vực banner.</p><div class="table-scroll"><table><thead><tr><th>Banner</th><th>Thứ tự</th><th>Hiển thị</th><th>Thao tác</th></tr></thead><tbody>@foreach(var b in Model){<tr><td><div class="table-product">@if(b.ImageUrl!=null){<img src="@b.ImageUrl" alt="@b.Title"/>}<b>@b.Title</b></div></td><td>@b.SortOrder</td><td>@(b.Active?"Có":"Ẩn")</td><td><div class="inline"><a class="secondary" href="@Url.Action("Edit",new{id=b.Id})">Sửa</a><form method="post" action="@Url.Action("Delete")" data-confirm="Xóa banner này?">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@b.Id"/><button class="text-button red">Xóa</button></form></div></td></tr>}</tbody></table></div></div>

