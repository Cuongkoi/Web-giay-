@model Banner
@{ViewBag.Title=Model.Id==0?"Thêm banner":"Sửa banner";}
<div class="container page"><a href="@Url.Action("Index")">← Banner</a><h1>@ViewBag.Title.</h1><form method="post" enctype="multipart/form-data" class="form-panel" action="@Url.Action("Edit",new{id=Model.Id})">@Html.AntiForgeryToken()@Html.ValidationSummary(false,"",new{@class="validation"})<label for="Title">Tiêu đề *</label>@Html.TextBoxFor(m=>m.Title,new{required="required",maxlength=160})<label for="Subtitle">Nội dung</label>@Html.TextAreaFor(m=>m.Subtitle,new{maxlength=500})<label for="imageFile">Ảnh banner PNG/JPG (tối đa 5 MB)</label><input name="imageFile" id="imageFile" type="file" accept=".png,.jpg,.jpeg,image/png,image/jpeg"/>@if(Model.ImageUrl!=null){<img class="banner-edit-preview" src="@Model.ImageUrl" alt="Banner hiện tại"/>}<div class="two-cols"><div><label for="ButtonText">Chữ trên nút</label>@Html.TextBoxFor(m=>m.ButtonText,new{maxlength=50})</div><div><label for="LinkUrl">Liên kết trong website</label>@Html.TextBoxFor(m=>m.LinkUrl,new{maxlength=500,placeholder="/?categoryId=1"})</div></div><label for="SortOrder">Thứ tự</label>@Html.TextBoxFor(m=>m.SortOrder,new{type="number",min=0,max=10000})<div class="checks"><label>@Html.CheckBoxFor(m=>m.Active) Hiển thị trên trang chủ</label></div><button class="button">LƯU BANNER →</button></form></div>

