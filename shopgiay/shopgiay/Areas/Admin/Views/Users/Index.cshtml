@model List<CustomerRow>
@{ViewBag.Title="Quản lý người dùng";}
<div class="container page"><span class="eyebrow">CUSTOMERS</span><h1>Quản lý người dùng.</h1><p class="muted">Khách quen là tài khoản có từ 3 đơn đã hoàn thành. Khóa tài khoản không xóa lịch sử mua hàng.</p><form class="admin-search" method="get"><input name="q" value="@ViewBag.Q" placeholder="Tìm họ tên hoặc email"/><button class="button">Tìm kiếm</button></form><div class="table-scroll"><table><thead><tr><th>Khách hàng</th><th>Đơn hoàn thành</th><th>Hạng khách</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>@foreach(var row in Model){<tr><td><b>@row.Customer.Name</b><small class="block">@row.Customer.Email</small></td><td>@row.CompletedOrders</td><td><span class="badge">@(row.CompletedOrders>=3?"Khách quen":"Khách hàng")</span></td><td>@(row.Customer.IsActive?"Hoạt động":"Đã khóa")</td><td><div class="inline"><a class="secondary" href="@Url.Action("Details",new{id=row.Customer.Id})">Chi tiết</a><form method="post" action="@Url.Action("SetActive")" data-confirm="Cập nhật trạng thái tài khoản này?">@Html.AntiForgeryToken()<input name="id" type="hidden" value="@row.Customer.Id"/><input name="active" type="hidden" value="@((!row.Customer.IsActive).ToString())"/><button class="secondary">@(row.Customer.IsActive?"Khóa":"Mở khóa")</button></form></div></td></tr>}</tbody></table></div></div>

