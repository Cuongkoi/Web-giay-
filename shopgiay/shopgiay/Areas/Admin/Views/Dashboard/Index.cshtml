@model DashboardViewModel
@using System.Globalization
@{ViewBag.Title="Dashboard thống kê";var productMax=Math.Max(1,Model.Products.Select(p=>p.Units).DefaultIfEmpty(0).Max());var customerMax=Math.Max(1,Model.Customers.Select(c=>c.Units).DefaultIfEmpty(0).Max());var colors=new[]{"#263e32","#6e8664","#a5b990","#c9b66e","#d39365","#9b7870","#c7ccc0"};decimal offset=0;}
<div class="container page dashboard-page"><div class="section-heading"><div><span class="eyebrow">STEP STORE / BUSINESS OVERVIEW</span><h1>Dashboard thống kê.</h1><p class="muted">Chỉ tính đơn đã hoàn thành. Khoảng thời gian lọc theo ngày đặt hàng.</p></div><form method="get"><label for="range" class="sr-only">Khoảng thời gian</label><select id="range" name="range" onchange="this.form.submit()"><option value="7" selected="@(Model.Range=="7")">7 ngày gần nhất</option><option value="30" selected="@(Model.Range=="30")">30 ngày gần nhất</option><option value="90" selected="@(Model.Range=="90")">90 ngày gần nhất</option><option value="all" selected="@(Model.Range=="all")">Tất cả thời gian</option></select><noscript><button class="secondary">Xem</button></noscript></form></div>
<div class="dashboard-stats"><article><small>DOANH THU ĐƠN HOÀN THÀNH</small><b>@Model.Revenue.ToString("N0")₫</b><span>Đã trừ voucher, gồm phí giao hàng</span></article><article><small>ĐƠN ĐÃ HOÀN THÀNH</small><b data-stat-orders>@Model.OrderCount</b><span>Không tính đơn hủy hoặc đang giao</span></article><article><small>SỐ ĐÔI GIÀY ĐÃ BÁN</small><b data-stat-units>@Model.Units</b><span>Tổng số lượng trong đơn hoàn thành</span></article><article><small>KHÁCH ĐÃ MUA HÀNG</small><b>@Model.CustomerCount</b><span>Tài khoản hoặc khách cũ theo số điện thoại</span></article></div>
<div class="dashboard-charts"><section class="dashboard-panel"><div class="section-heading"><div><span class="eyebrow">BEST SELLERS</span><h2>Giày bán chạy</h2></div><span>Top 8 · Số đôi</span></div>@if(Model.Products.Count==0){<p class="empty">Chưa có đơn hoàn thành trong khoảng thời gian này.</p>}else{<div class="sales-bars" role="img" aria-label="Biểu đồ giày bán chạy theo số đôi">@foreach(var product in Model.Products){<div class="sales-bar-row" data-product-id="@product.ProductId" data-units="@product.Units"><span title="@product.Name">@product.Name</span><div class="sales-bar-track"><div class="sales-bar-fill" style="width:@((product.Units*100m/productMax).ToString("0.##",CultureInfo.InvariantCulture))%"></div></div><b>@product.Units</b></div>}</div>}</section>
<section class="dashboard-panel"><div class="section-heading"><div><span class="eyebrow">BRAND PERFORMANCE</span><h2>Thương hiệu bán chạy</h2></div><span>Số đôi đã bán</span></div>@if(Model.Units==0){<p class="empty">Chưa có dữ liệu thương hiệu.</p>}else{<div class="brand-chart"><div class="donut-wrap"><svg viewBox="0 0 120 120" role="img" aria-label="Tỷ trọng số đôi theo thương hiệu"><circle cx="60" cy="60" r="45" fill="none" stroke="#edf0e7" stroke-width="17"/>@for(int i=0;i<Model.Brands.Count;i++){var brand=Model.Brands[i];var share=brand.Units*100m/Model.Units;<circle cx="60" cy="60" r="45" fill="none" stroke="@colors[i%colors.Length]" stroke-width="17" pathLength="100" stroke-dasharray="@(share.ToString("0.###",CultureInfo.InvariantCulture)) @((100-share).ToString("0.###",CultureInfo.InvariantCulture))" stroke-dashoffset="@((-offset).ToString("0.###",CultureInfo.InvariantCulture))" transform="rotate(-90 60 60)"><title>@brand.Name: @brand.Units đôi</title></circle>offset+=share;}</svg><div><b>@Model.Units</b><small>ĐÔI GIÀY</small></div></div><div class="brand-legend">@for(int i=0;i<Model.Brands.Count;i++){var brand=Model.Brands[i];<div><span class="legend-dot" style="background:@colors[i%colors.Length]"></span><span>@brand.Name</span><b>@brand.Units</b></div>}</div></div>}</section>
<section class="dashboard-panel dashboard-wide"><div class="section-heading"><div><span class="eyebrow">TOP CUSTOMERS</span><h2>Khách mua nhiều hàng nhất</h2></div><a class="secondary" href="/Admin/Users">Quản lý người dùng →</a></div>@if(Model.Customers.Count==0){<p class="empty">Chưa có khách mua hàng trong khoảng thời gian này.</p>}else{<div class="sales-bars customer-sales-bars" role="img" aria-label="Biểu đồ khách mua nhiều đôi nhất">@foreach(var customer in Model.Customers){<div class="sales-bar-row" data-customer-id="@customer.CustomerId" data-units="@customer.Units"><span title="@customer.Name">@customer.Name</span><div class="sales-bar-track"><div class="sales-bar-fill" style="width:@((customer.Units*100m/customerMax).ToString("0.##",CultureInfo.InvariantCulture))%"></div></div><b>@customer.Units</b></div>}</div><div class="table-scroll"><table><thead><tr><th>Khách hàng</th><th>Email</th><th>Số đơn</th><th>Số đôi</th><th>Tổng chi</th></tr></thead><tbody>@foreach(var customer in Model.Customers){<tr><td>@if(customer.CustomerId.HasValue){<a href="/Admin/Users/Details/@customer.CustomerId"><b>@customer.Name</b></a>}else{<b>@customer.Name</b>}</td><td>@(customer.Email??"Khách cũ chưa có tài khoản")</td><td>@customer.Orders</td><td>@customer.Units</td><td>@customer.Spending.ToString("N0")₫</td></tr>}</tbody></table></div>}</section></div><p class="muted dashboard-note">Thương hiệu được lưu theo từng lần đặt hàng để đổi tên hoặc xóa sản phẩm sau này không làm mất thống kê. Đơn cũ không còn đủ thông tin được hiển thị là “Chưa xác định”.</p></div>

